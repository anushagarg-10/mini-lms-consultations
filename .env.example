# Local: run `npx supabase status -o env` after `npx supabase start` and copy
#   API_URL         -> NEXT_PUBLIC_SUPABASE_URL
#   PUBLISHABLE_KEY -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (the legacy ANON_KEY also works)
# Hosted: Project Settings > API.
#
# Never put the service-role / secret key in a NEXT_PUBLIC_ variable. The app doesn't need it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
